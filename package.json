{
  "name": "codex-plugin-agy",
  "version": "0.1.1",
  "private": true,
  "type": "module",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=18.18.0"
  },
  "scripts": {
    "generate:protocol": "codex app-server generate-ts --out .generated/app-server-types",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.upstream.json",
    "build": "node scripts/build.mjs",
    "test": "npm run build && node --test --test-concurrency=1",
    "test:unit": "node --test tests/unit",
    "test:integration": "node --test tests/integration",
    "test:mcp": "node --test tests/mcp",
    "test:security": "node --test tests/security",
    "package": "node scripts/package.mjs",
    "test:package": "node --test tests/integration/package-bundle.test.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "esbuild": "^0.28.0",
    "typescript": "~5.9.3"
  }
}
